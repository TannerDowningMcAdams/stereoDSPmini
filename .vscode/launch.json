{
    "version": "0.2.0",
    "configurations": [
        {
            // Builds, then GDB loads the ELF over SWD and runs to main.
            "name": "H7 / Launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/H7/build/Debug/stereoDSPminiH7_cubeMX.elf",
            "device": "STM32H743VITx",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "preLaunchTask": "CMake: build",
            "runToEntryPoint": "main",
            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "svdPath": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H743.svd",
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe"
        },
        {
            // No preLaunchTask on purpose: attaching must not reflash or reset.
            "name": "H7 / Attach while running",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/H7/build/Debug/stereoDSPminiH7_cubeMX.elf",
            "device": "STM32H743VITx",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "stlink",
            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "svdPath": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H743.svd",
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "postAttachCommands": []
        },
        {
            "name": "G0 / Launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/G0/build/Debug/stereoDSPminiG0_cubeMX.elf",
            "device": "STM32G030C8Tx",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "stlink",
            "preLaunchTask": "CMake: build",
            "runToEntryPoint": "main",
            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "svdPath": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32G030.svd",
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe"
        },
        {
            "name": "G0 / Attach while running",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/G0/build/Debug/stereoDSPminiG0_cubeMX.elf",
            "device": "STM32G030C8Tx",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "stlink",
            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "svdPath": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32G030.svd",
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "postAttachCommands": []
        },
        {
            "name": "Bridge / Attach while running",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/tools/bridge/build/Debug/stereoDSPminiBridge_cubeMX.elf",
            "device": "STM32H743VITx",
            "request": "attach",
            "type": "cortex-debug",
            "servertype": "stlink",
            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "svdPath": "${env:STM32CLT_PATH}/STMicroelectronics_CMSIS_SVD/STM32H743.svd",
            "armToolchainPath": "${env:STM32CLT_PATH}/GNU-tools-for-STM32/bin",
            "serverpath": "${env:STM32CLT_PATH}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "postAttachCommands": []
        }
    ]
}
