{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "Debug",
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "cmake",
			"label": "CMake: configure",
			"command": "configure",
			"preset": "Debug",
			"problemMatcher": [],
			"detail": "CMake template configure task"
		},
		{
			// CLT path, not bare name, so PATH order cannot pick the extension's bundled copy.
			"label": "Flash: H7 (SWD)",
			"type": "process",
			"command": "${env:STM32CLT_PATH}/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
			"args": [
				"-c", "port=SWD",
				"-d", "${workspaceFolder}/build/Debug/stereoDSPminiH7_cubeMX.elf", "-v",
				"-rst"
			],
			"problemMatcher": [],
			"presentation": { "reveal": "always", "panel": "dedicated" }
		},
		{
			"label": "Build + Flash",
			"dependsOrder": "sequence",
			"dependsOn": [
				"CMake: build",
				"Flash: H7 (SWD)"
			],
			"problemMatcher": []
		}
	]
}
